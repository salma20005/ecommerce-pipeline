    <!-- bytes: 768 * 1024 * 1024 (ClickHouse rejects suffixes like 'm' here) -->
    <max_server_memory_usage>805306368</max_server_memory_usage>
    <max_concurrent_queries>40</max_concurrent_queries>
</clickhouse>
